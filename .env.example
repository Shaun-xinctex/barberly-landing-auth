# Supabase project the browser client talks to.
# Both values are safe to expose: the publishable key is browser-facing and
# every table is gated by Row Level Security.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_PROJECT_ID="<project-ref>"
